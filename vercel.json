{
  "version": 2,
  "builds": [
    {
      "src": "vercel/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{tools/**,ai/**,utils/**}"
      }
    },
    {
      "src": "vercel/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "vercel/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "vercel/index.html"
    }
  ]
}
