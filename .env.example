# Groq API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Remote Embedding API Key (if switching from local SentenceTransformers)
EMBEDDING_API_KEY=

# Optional: Cloud Vector Database (e.g., Supabase / Pinecone if switching from local FAISS)
VECTOR_DB_URL=
VECTOR_DB_KEY=
